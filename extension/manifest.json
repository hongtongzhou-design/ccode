{
  "manifest_version": 3,
  "name": "Mesa 文献收货",
  "version": "0.1.0",
  "description": "文献页一键把 PDF 存进 Mesa 当前项目 papers/（真实浏览器会话下载，不触发出版商风控）",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "webRequest", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "存到 Mesa（PDF 页点击即下载，Mesa 自动收进 papers/）"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" }
}
