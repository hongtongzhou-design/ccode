{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesa Dev Sandbox",
  "identifier": "com.ccode.dev.sandbox",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 17577 --strictPort",
    "devUrl": "http://127.0.0.1:17577"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Mesa Dev - 新用户沙盒 :17577",
        "create": false,
        "width": 1100,
        "height": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["menu", "mica"],
          "state": "followsWindowActiveState"
        }
      }
    ]
  }
}
