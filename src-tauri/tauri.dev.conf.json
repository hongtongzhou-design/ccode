{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesa Dev",
  "identifier": "com.ccode.dev.hmr",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:17575"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Mesa Dev - 热更新",
        "create": false,
        "width": 1100,
        "height": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "menu",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ]
  }
}