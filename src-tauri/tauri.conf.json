{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ccode",
  "version": "0.1.1",
  "identifier": "com.ccode.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ccode",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCMjg0MDE1RUI3RDI4OTMKUldTVEtIM3JGVUFvZTM4TXBPV0hpaThON3Y1aWtmWWZEUDRaZFVNMlEwbnROY2daRDJiWitYMEMK",
      "endpoints": [
        "https://github.com/hongtongzhou-design/ccode/releases/latest/download/latest.json"
      ]
    }
  }
}
